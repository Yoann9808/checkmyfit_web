function sizesForCategory(category) {
  if (category === "Chaussures")
    return ["39", "40", "41", "42", "43", "44", "45"];
  if (category === "Jean") return ["36", "38", "40", "42", "44"];
  if (category === "Accessoires") return ["Taille unique"];
  return ["XS", "S", "M", "L", "XL", "XXL"];
}

