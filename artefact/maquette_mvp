export default function CheckmyfitPrototype() {
  const [screen, setScreen] = useState("home");
  const [returnTo, setReturnTo] = useState("product");
  const [selectedProductId, setSelectedProductId] = useState(PRODUCTS[0].id);
  const [selectedTryOnId, setSelectedTryOnId] = useState(null);
  const [selectedSize, setSelectedSize] = useState(null);

  const [filters, setFilters] = useState({
    category: "Toutes",
    brand: "Toutes",
    color: "Toutes",
    gender: "Toutes",
    priceMax: 300,
  });

  const [session, setSession] = useState({
    account: null, // { email }
    photoPreview: PHOTO_FEMME_DEFAULT,
    photoUploaded: true,
    aiResults: {}, // productId -> true
    aiCredits: 20, // remaining AI generation credits
    dressingSaved: [], // productIds saved via "SAUVER CE LOOK"
    dressingMine: [], // custom-added items { id, category, color, photo }
    cart: [], // { productId, size, qty }
    orders: [], // { number, date, itemsCount, total }
    onboardingSeen: false,
  });

  const [openFilterKey, setOpenFilterKey] = useState(null); // only one filter dropdown open at a time
  const [selectedCreditPack, setSelectedCreditPack] = useState(null);
  const [creditsReturnTo, setCreditsReturnTo] = useState("home");
  const [creditsPaymentForm, setCreditsPaymentForm] = useState({
    nom: "",
    carte: "",
  });
  const [creditsPurchased, setCreditsPurchased] = useState(null);
  const [signupForm, setSignupForm] = useState({ email: "", password: "" });
  const [checkoutForm, setCheckoutForm] = useState({
    nom: "",
    adresse: "",
    ville: "",
    cp: "",
    carte: "",
  });
  const [dressingTab, setDressingTab] = useState("Futurs achats");
  const [generatingIndex, setGeneratingIndex] = useState(0);
  const [orderNumber, setOrderNumber] = useState(null);
  const [showAddModal, setShowAddModal] = useState(false);
  const [newItem, setNewItem] = useState({
    brand: "",
    category: CATEGORIES_BASE[0],
    color: "",
    photo: null,
  });
  const fileInputRef = useRef(null);
  const modalFileInputRef = useRef(null);

  const product = PRODUCTS.find((p) => p.id === selectedProductId);
  const cartCount = session.cart.reduce((sum, i) => sum + i.qty, 0);

  const goToProduct = (id) => {
    setSelectedProductId(id);
    setSelectedSize(null);
    setScreen("product");
  };

  const openDressing = () => setScreen("dressing");

  /* --- essai virtuel flow, shared by product page and Essayage page --- */
  const handleTryOnFor = (productId, origin = "product") => {
    setSelectedProductId(productId);
    setReturnTo(origin);
    if (!session.account) {
      setScreen("signup");
      return;
    }
    if (!session.aiResults[productId]) {
      if (session.aiCredits <= 0) return; // no credits left
      setSession((s) => ({ ...s, aiCredits: s.aiCredits - 1 }));
      setGeneratingIndex(0);
      setScreen("generating");
      return;
    }
    setScreen("result");
  };

  useEffect(() => {
    if (screen !== "generating") return;
    if (generatingIndex >= GENERATION_STEPS.length - 1) {
      const t = setTimeout(() => {
        setSession((s) => ({
          ...s,
          aiResults: { ...s.aiResults, [selectedProductId]: true },
        }));
        setScreen("result");
      }, 900);
      return () => clearTimeout(t);
    }
    const t = setTimeout(() => setGeneratingIndex((i) => i + 1), 750);
    return () => clearTimeout(t);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [screen, generatingIndex]);

  const handleSignup = (e) => {
    e.preventDefault();
    setSession((s) => ({
      ...s,
      account: { email: signupForm.email || "vous@checkmyfit.fr" },
    }));
    setScreen(session.photoUploaded ? returnTo : "upload");
  };

  const handleGoogleSignup = () => {
    setSession((s) => ({ ...s, account: { email: "vous@gmail.com" } }));
    setScreen(session.photoUploaded ? returnTo : "upload");
  };

  const handlePhotoFile = (file) => {
    if (!file) return;
    const url = URL.createObjectURL(file);
    setSession((s) => ({ ...s, photoPreview: url }));
  };

  const confirmPhoto = () => {
    setSession((s) => ({ ...s, photoUploaded: true }));
    setScreen(returnTo);
  };

  const saveLook = () => {
    setSession((s) => ({
      ...s,
      dressingSaved: s.dressingSaved.includes(selectedProductId)
        ? s.dressingSaved
        : [...s.dressingSaved, selectedProductId],
    }));
    setScreen("saved");
  };

  const addToCart = () => {
    setSession((s) => {
      const size = selectedSize || sizesForCategory(product.category)[0];
      const existing = s.cart.find(
        (i) => i.productId === product.id && i.size === size,
      );
      const cart = existing
        ? s.cart.map((i) => (i === existing ? { ...i, qty: i.qty + 1 } : i))
        : [...s.cart, { productId: product.id, size, qty: 1 }];
      return { ...s, cart };
    });
  };

  const updateQty = (idx, delta) => {
    setSession((s) => {
      const cart = s.cart
        .map((i, ix) => (ix === idx ? { ...i, qty: i.qty + delta } : i))
        .filter((i) => i.qty > 0);
      return { ...s, cart };
    });
  };

  const placeOrder = (e) => {
    e.preventDefault();
    const number = "CMF-" + Math.floor(100000 + Math.random() * 900000);
    const itemsCount = session.cart.reduce((s, i) => s + i.qty, 0);
    const total = session.cart.reduce(
      (s, i) =>
        s + (PRODUCTS.find((p) => p.id === i.productId)?.price || 0) * i.qty,
      0,
    );
    const date = new Date().toLocaleDateString("fr-FR");
    setOrderNumber(number);
    setSession((s) => ({
      ...s,
      cart: [],
      orders: [{ number, date, itemsCount, total }, ...s.orders],
    }));
    setScreen("orderConfirmed");
  };

  const handleBuyCredits = (e) => {
    e.preventDefault();
    if (!selectedCreditPack) return;
    setSession((s) => ({
      ...s,
      aiCredits: s.aiCredits + selectedCreditPack.credits,
    }));
    setCreditsPurchased(selectedCreditPack);
    setScreen("creditsConfirmed");
  };

  const addDressingItem = () => {
    setSession((s) => ({
      ...s,
      dressingMine: [
        ...s.dressingMine,
        {
          id: "mine-" + Date.now(),
          brand: newItem.brand || "Non précisée",
          category: newItem.category,
          color: newItem.color || "Non précisée",
          photo: newItem.photo,
        },
      ],
    }));
    setNewItem({
      brand: "",
      category: CATEGORIES_BASE[0],
      color: "",
      photo: null,
    });
    setShowAddModal(false);
  };

  const filteredProducts = PRODUCTS.filter(
    (p) =>
      (filters.category === "Toutes" || p.category === filters.category) &&
      (filters.brand === "Toutes" || p.brand === filters.brand) &&
      (filters.color === "Toutes" || p.color === filters.color) &&
      (filters.gender === "Toutes" || p.gender === filters.gender) &&
      p.price <= filters.priceMax,
  );

  const clearFilter = (key) => {
    setFilters((f) => ({ ...f, [key]: key === "priceMax" ? 300 : "Toutes" }));
  };

  const activeFilterChips = [
    filters.category !== "Toutes" && {
      key: "category",
      label: `Catégorie : ${filters.category}`,
    },
    filters.brand !== "Toutes" && {
      key: "brand",
      label: `Marque : ${filters.brand}`,
    },
    filters.color !== "Toutes" && {
      key: "color",
      label: `Couleur : ${filters.color}`,
    },
    filters.gender !== "Toutes" && {
      key: "gender",
      label: `Sexe : ${filters.gender}`,
    },
    filters.priceMax < 300 && {
      key: "priceMax",
      label: `Prix : jusqu'à ${filters.priceMax} €`,
    },
  ].filter(Boolean);

  /* ------------------------------------------------------------------ */
  /* Shared header + nav                                                  */
  /* ------------------------------------------------------------------ */
  const Header = () => (
    <header className="sticky top-0 z-30 bg-[#F5E8DC]/95 backdrop-blur border-b border-[#DECCB0]">
      <div className="max-w-5xl mx-auto flex items-center justify-between px-5 py-4">
        <button
          onClick={() => setScreen("home")}
          className="flex items-center gap-1.5 font-display italic text-xl"
        >
          <span style={{ color: C.terracotta }}>Check</span>
          <DoorOpen size={20} style={{ color: C.wenge }} strokeWidth={1.5} />
          <span
            style={{ color: C.palissandre }}
            className="not-italic font-medium"
          >
            MyFit
          </span>
        </button>
        <nav
          className="hidden md:flex items-center gap-6 font-body text-sm uppercase tracking-wide"
          style={{ color: C.wenge }}
        >
          <button
            onClick={() => setScreen("listing")}
            className="hover:text-[#4A2009]"
          >
            Catalogue
          </button>
          <button
            onClick={() => setScreen("essayage")}
            className="hover:text-[#4A2009]"
          >
