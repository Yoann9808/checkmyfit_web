                      {i.product.image ? (
                        <img
                          src={i.product.image}
                          alt=""
                          className="w-full h-full object-contain"
                        />
                      ) : (
                        familyIcon(i.product.category, "w-8 h-8 text-[#4A2009]")
                      )}
                    </div>
                    <div className="flex-1">
                      <p
                        className="font-body text-[11px] uppercase"
                        style={{ color: C.noyer }}
                      >
                        {i.product.brand}
                      </p>
                      <p
                        className="font-display"
                        style={{ color: C.palissandre }}
                      >
                        {i.product.name}
                      </p>
                      <p
                        className="font-body text-xs"
                        style={{ color: C.wenge }}
                      >
                        Taille {i.size}
                      </p>
                    </div>
                    <div className="flex items-center gap-2">
                      <button
                        onClick={() => updateQty(idx, -1)}
                        className="w-7 h-7 rounded-full border flex items-center justify-center"
                        style={{ borderColor: C.noyer, color: C.palissandre }}
                      >
                        <Minus size={12} />
                      </button>
                      <span
                        className="font-body text-sm w-5 text-center"
                        style={{ color: C.palissandre }}
                      >
                        {i.qty}
                      </span>
                      <button
                        onClick={() => updateQty(idx, 1)}
                        className="w-7 h-7 rounded-full border flex items-center justify-center"
                        style={{ borderColor: C.noyer, color: C.palissandre }}
                      >
                        <Plus size={12} />
                      </button>
                    </div>
                    <p
                      className="font-body text-sm w-16 text-right"
                      style={{ color: C.palissandre }}
                    >
                      {i.product.price * i.qty} €
                    </p>
                  </div>
                ))}
              </div>
              <div
                className="flex items-center justify-between mt-8 pt-6 border-t"
                style={{ borderColor: C.cheneDore }}
              >
                <span
                  className="font-body text-sm uppercase tracking-wide"
                  style={{ color: C.wenge }}
                >
                  Total
                </span>
                <span
                  className="font-display text-2xl"
                  style={{ color: C.palissandre }}
                >
                  {total} €
                </span>
              </div>
              <PrimaryButton
                onClick={() => setScreen("checkout")}
                className="w-full mt-6"
              >
                Passer commande
              </PrimaryButton>
            </>
          )}
        </section>
      </div>
    );
  };

  /* ==================================================================== */
  /* SCREEN — CHECKOUT                                                     */
  /* ==================================================================== */
  const CheckoutScreen = () => (
    <div>
      <Header />
      <section className="max-w-md mx-auto px-5 py-10">
        <BackBar onBack={() => setScreen("cart")} label="Retour au panier" />
        <h1
          className="font-display text-4xl mb-6"
          style={{ color: C.palissandre }}
        >
          Finaliser la commande
        </h1>
        <form onSubmit={placeOrder} className="flex flex-col gap-4">
          <div>
            <p
              className="font-body text-[11px] uppercase tracking-wide mb-2 flex items-center gap-1.5"
              style={{ color: C.wenge }}
            >
              <MapPin size={12} /> Livraison
            </p>
            <input
              required
              placeholder="Nom complet"
              value={checkoutForm.nom}
              onChange={(e) =>
                setCheckoutForm((f) => ({ ...f, nom: e.target.value }))
              }
              className="font-body text-sm px-4 py-3 rounded-xl border border-[#C2A47A] bg-white/40 outline-none focus:border-[#B05C2A] w-full mb-2"
              style={{ color: C.palissandre }}
            />
            <input
              required
              placeholder="Adresse"
              value={checkoutForm.adresse}
              onChange={(e) =>
                setCheckoutForm((f) => ({ ...f, adresse: e.target.value }))
              }
              className="font-body text-sm px-4 py-3 rounded-xl border border-[#C2A47A] bg-white/40 outline-none focus:border-[#B05C2A] w-full mb-2"
              style={{ color: C.palissandre }}
            />
            <div className="flex gap-2">
              <input
                required
                placeholder="Ville"
                value={checkoutForm.ville}
                onChange={(e) =>
                  setCheckoutForm((f) => ({ ...f, ville: e.target.value }))
                }
                className="font-body text-sm px-4 py-3 rounded-xl border border-[#C2A47A] bg-white/40 outline-none focus:border-[#B05C2A] flex-1"
                style={{ color: C.palissandre }}
              />
              <input
                required
                placeholder="Code postal"
                value={checkoutForm.cp}
                onChange={(e) =>
                  setCheckoutForm((f) => ({ ...f, cp: e.target.value }))
                }
                className="font-body text-sm px-4 py-3 rounded-xl border border-[#C2A47A] bg-white/40 outline-none focus:border-[#B05C2A] w-32"
                style={{ color: C.palissandre }}
              />
            </div>
          </div>
          <div>
            <p
              className="font-body text-[11px] uppercase tracking-wide mb-2 mt-2 flex items-center gap-1.5"
              style={{ color: C.wenge }}
            >
              <CreditCard size={12} /> Paiement
            </p>
            <input
              required
              placeholder="Numéro de carte (mock)"
              value={checkoutForm.carte}
              onChange={(e) =>
                setCheckoutForm((f) => ({ ...f, carte: e.target.value }))
              }
              className="font-body text-sm px-4 py-3 rounded-xl border border-[#C2A47A] bg-white/40 outline-none focus:border-[#B05C2A] w-full"
              style={{ color: C.palissandre }}
            />
          </div>
          <PrimaryButton type="submit" className="w-full mt-4">
            Confirmer la commande
          </PrimaryButton>
        </form>
      </section>
    </div>
  );

  const OrderConfirmedScreen = () => (
    <div>
      <Header />
      <section className="max-w-md mx-auto px-5 py-20 text-center">
        <div
          className="w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-6"
          style={{ backgroundColor: C.palissandre }}
        >
          <Check className="w-7 h-7" style={{ color: C.argile }} />
        </div>
        <h1 className="font-display text-3xl" style={{ color: C.palissandre }}>
          Commande confirmée
        </h1>
        <p className="font-body text-sm mt-2" style={{ color: C.wenge }}>
          Référence {orderNumber}. Un e-mail de confirmation vient de partir.
        </p>
        <PrimaryButton onClick={() => setScreen("home")} className="mt-8">
          Retour à l'accueil
        </PrimaryButton>
      </section>
    </div>
  );

  /* ==================================================================== */
  /* SCREEN — CREDITS (racheter des crédits IA)                           */
  /* ==================================================================== */
  const CreditsScreen = () => (
    <div>
      <Header />
      <section className="max-w-2xl mx-auto px-5 py-10">
        <BackBar onBack={() => setScreen(creditsReturnTo)} />
        <h1
          className="font-display text-4xl mb-1"
          style={{ color: C.palissandre }}
        >
          Racheter des crédits IA
        </h1>
        <p className="font-body text-sm mb-8" style={{ color: C.wenge }}>
          Solde actuel :{" "}
          <span style={{ color: C.terracotta }}>
            {session.aiCredits} crédit{session.aiCredits > 1 ? "s" : ""}
          </span>
          . Chaque essayage virtuel consomme 1 crédit.
        </p>
        <div className="grid sm:grid-cols-3 gap-4 mb-8">
          {CREDIT_PACKS.map((pack) => {
            const selected = selectedCreditPack?.id === pack.id;
            return (
              <button
                key={pack.id}
                onClick={() => setSelectedCreditPack(pack)}
                className="relative text-left rounded-2xl border-2 p-5 transition-colors"
                style={{
                  borderColor: selected ? C.terracotta : C.cheneDore,
                  backgroundColor: selected ? C.chenePale : C.argile,
                }}
              >
                {pack.popular && (
                  <div className="absolute -top-3 left-4">
                    <Badge tone="saved">Populaire</Badge>
                  </div>
                )}
                <p
                  className="font-display text-2xl"
                  style={{ color: C.palissandre }}
                >
                  {pack.credits}
                </p>
                <p
                  className="font-body text-[11px] uppercase tracking-wide mb-3"
                  style={{ color: C.noyer }}
                >
                  crédits IA
                </p>
                <p className="font-body text-lg" style={{ color: C.wenge }}>
                  {pack.price.toFixed(2).replace(".", ",")} €
                </p>
                {pack.unitLabel && (
                  <p
                    className="font-body text-[10px] mt-1"
                    style={{ color: C.terracotta }}
                  >
                    {pack.unitLabel}
                  </p>
                )}
              </button>
            );
          })}
        </div>
        <PrimaryButton
          disabled={!selectedCreditPack}
          onClick={() => setScreen("creditsPayment")}
          className="w-full"
        >
          Continuer
        </PrimaryButton>
      </section>
    </div>
  );

  /* ==================================================================== */
  /* SCREEN — CREDITS PAYMENT                                              */
  /* ==================================================================== */
  const CreditsPaymentScreen = () => (
    <div>
      <Header />
      <section className="max-w-md mx-auto px-5 py-10">
        <BackBar
          onBack={() => setScreen("credits")}
          label="Retour aux formules"
        />
        <h1
          className="font-display text-4xl mb-6"
          style={{ color: C.palissandre }}
        >
          Paiement
        </h1>
        {selectedCreditPack && (
          <div
            className="rounded-2xl p-4 mb-6 flex items-center justify-between"
            style={{ backgroundColor: C.chenePale }}
          >
            <div>
              <p className="font-display" style={{ color: C.palissandre }}>
                {selectedCreditPack.credits} crédits IA
              </p>
              <p className="font-body text-xs" style={{ color: C.wenge }}>
                Achat unique, crédités immédiatement
              </p>
            </div>
            <p
              className="font-display text-xl"
              style={{ color: C.palissandre }}
            >
              {selectedCreditPack.price.toFixed(2).replace(".", ",")} €
            </p>
          </div>
        )}
        <form onSubmit={handleBuyCredits} className="flex flex-col gap-4">
          <div>
            <p
              className="font-body text-[11px] uppercase tracking-wide mb-2 flex items-center gap-1.5"
              style={{ color: C.wenge }}
            >
              <CreditCard size={12} /> Carte bancaire
            </p>
            <input
              required
              placeholder="Nom sur la carte"
              value={creditsPaymentForm.nom}
              onChange={(e) =>
                setCreditsPaymentForm((f) => ({ ...f, nom: e.target.value }))
              }
              className="font-body text-sm px-4 py-3 rounded-xl border border-[#C2A47A] bg-white/40 outline-none focus:border-[#B05C2A] w-full mb-2"
              style={{ color: C.palissandre }}
            />
            <input
              required
              placeholder="Numéro de carte (mock)"
              value={creditsPaymentForm.carte}
              onChange={(e) =>
                setCreditsPaymentForm((f) => ({ ...f, carte: e.target.value }))
              }
              className="font-body text-sm px-4 py-3 rounded-xl border border-[#C2A47A] bg-white/40 outline-none focus:border-[#B05C2A] w-full"
              style={{ color: C.palissandre }}
            />
          </div>
          <PrimaryButton type="submit" className="w-full mt-2">
            Payer{" "}
            {selectedCreditPack
              ? selectedCreditPack.price.toFixed(2).replace(".", ",") + " €"
              : ""}
          </PrimaryButton>
        </form>
      </section>
    </div>
  );

  /* ==================================================================== */
  /* SCREEN — CREDITS CONFIRMED                                            */
  /* ==================================================================== */
  const CreditsConfirmedScreen = () => (
    <div>
      <Header />
      <section className="max-w-md mx-auto px-5 py-20 text-center">
        <div
          className="w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-6"
          style={{ backgroundColor: C.palissandre }}
        >
          <Check className="w-7 h-7" style={{ color: C.argile }} />
        </div>
        <h1 className="font-display text-3xl" style={{ color: C.palissandre }}>
          Crédits ajoutés
        </h1>
        <p className="font-body text-sm mt-2" style={{ color: C.wenge }}>
          {creditsPurchased ? `+${creditsPurchased.credits} crédits IA. ` : ""}
          Nouveau solde : {session.aiCredits} crédits.
        </p>
        <PrimaryButton
          onClick={() => setScreen(creditsReturnTo)}
          className="mt-8"
        >
          Retour
        </PrimaryButton>
      </section>
    </div>
  );

  /* ------------------------------------------------------------------ */
  /* Router                                                                */
  /* ------------------------------------------------------------------ */
  const screens = {
    home: HomeScreen,
    listing: ListingScreen,
    essayage: EssayageScreen,
    product: ProductScreen,
    signup: SignupScreen,
    upload: UploadScreen,
    generating: GeneratingScreen,
    result: ResultScreen,
    saved: SavedScreen,
    dressing: DressingScreen,
    profile: ProfileScreen,
    cart: CartScreen,
    checkout: CheckoutScreen,
    orderConfirmed: OrderConfirmedScreen,
    credits: CreditsScreen,
    creditsPayment: CreditsPaymentScreen,
    creditsConfirmed: CreditsConfirmedScreen,
  };
  const CurrentScreen = screens[screen] || HomeScreen;

  return (
    <div
      className="min-h-screen font-body"
      style={{ backgroundColor: C.argile }}
    >
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;1,300&family=DM+Sans:wght@300;500&display=swap');
        .font-display { font-family: 'Fraunces', serif; font-weight: 300; }
        .font-body { font-family: 'DM Sans', sans-serif; font-weight: 300; }
      `}</style>
      <CurrentScreen />
    </div>
  );
}
